{
  "name": "stroke-board",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "clean": "rm -rf .output .nuxt node_modules/.vite node_modules/.cache .e2e-tmp test-results",
    "preview": "nuxt preview",
    "start": "nuxt dev",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "spec": "openspec validate --all",
    "check": "yarn typecheck && yarn spec",
    "session": "tsx --env-file-if-exists=.env scripts/session.ts",
    "check:ws-disconnect": "tsx scripts/ws-disconnect-check.ts",
    "check:stroke": "tsx scripts/stroke-check.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/mcp-toolkit": "0.19.0",
    "@nuxtjs/mdc": "^0.23.1",
    "@vueuse/core": "^14.4.0",
    "fs-extra": "^11.4.0",
    "javascript-time-ago": "^2.6.4",
    "mermaid": "^10.9.1",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10"
  }
}

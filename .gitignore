# Nuxt
.nuxt/
.output/
.data/
.nitro/
.cache/
dist/

# 依存
node_modules/
# nodeLinker: node-modules なので PnP 系（.pnp.*）は生じない
.yarn/*
!.yarn/patches/
!.yarn/releases/
!.yarn/plugins/
!.yarn/versions/

# 環境
.env
.env.*
!.env.example

# ログ・OS・エディタ
*.log
.DS_Store
*.local
*.swp

# テスト
test-results/
playwright-report/

# 開発者個人の Claude Code 設定。エンドユーザーのセッションへ持ち込まない（ADR 0001）
# マシンローカルな絶対パス symlink も含むため、ディレクトリごとではなく `/*` で中身を無視する
# （ディレクトリごと無視すると中身が走査されず下の例外が効かない）
.claude/*
# ただし permission 設定はリポジトリ共通なので追跡する
!.claude/settings.json
# assets/.claude/ はアプリの配布物なので追跡する。いま残るのは文書の雛形（template/）だけで、
# 操作系のセッション API スキルは撤去済み（adr0016-sub-switch-workflow-to-mcp-tools）
!assets/.claude/

# ローカル専用
.session_init/

# E2E の作業領域
.e2e-tmp/

# `yarn check:stroke` が書き出すセッションの経過（HTML）
.stroke-check/

# openspec の store 登録マーカー。マシンローカルな台帳メタデータで、リポジトリの成果物ではない
.openspec-store/

# cork（ticket の一覧ビュー）の副産物。列の定義はマシンごとの表示設定、
# `._*` は ticket を開くたびに書かれる AppleDouble。どちらも成果物ではない
openspec/tickets/.cork.json
openspec/tickets/._*

# nanopm — local PM state (not for version control)
.nanopm/

# @nuxt/test-utils がテスト実行時に書く生成物。ツール定義の置き場（ファイル名＝ツール名）に
# 成果物でないファイルを残さない（provide-operations-via-mcp・santa-method レビュー指摘）
server/mcp/tools/.nuxtrc

# yarn の移行が残すバックアップ（node_modules.yarn-bak / .nuxt.yarn-bak）。
# 生成物のコピーであって成果物ではない。一度 11,466 ファイル・307MB を履歴へ入れた
# ことがあるので、名前で丸ごと落とす
*.yarn-bak/

# @nuxt/test-utils がテスト実行時に書く生成物。`server/mcp/tools/.nuxtrc` と同じもので、
# ルート側も追跡しない
/.nuxtrc

# subagent のリンク解決結果。道具がマシンごとに書き直すロック
.subagents.lock.json

# 本家 spec-workflow-mcp のダッシュボードの URL。別途起動しておく（proposal.md の Dependencies）
NUXT_UPSTREAM_BASE_URL=http://127.0.0.1:5000

# `.spec-workflow` を持つディレクトリを探す親パス。直下1階層だけを走査する
NUXT_PROJECTS_PARENT_PATH=/opt/projects

# 本家のグローバル状態の置き場。activeProjects.json がここにある。
# 本家の SPEC_WORKFLOW_HOME と同じ値を指すこと。未設定なら ~/.spec-workflow-mcp に落ちる
NUXT_SPEC_WORKFLOW_HOME=/opt/projects/.spec-workflow-mcp

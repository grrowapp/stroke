# stroke-board — `.env` で差し替えられる設定
#
# これは差し替えるためのテンプレートである。
#
# stroke（旧 frontier）側の設定の正は docs/settings-reference.md である
# （docs/adr/0004-settings-reference-is-authoritative.md）。そこに無いものは設定ではない。
# 設定を足す・消す・既定値を変えるには、change を起こしてユーザーの承認を得る。
#
# 使い方:
#   cp .env.example .env   して、変えたい行だけコメントを外す
#   dev サーバーは .env を自動で読む。`yarn session`（CLI）は --env-file-if-exists で読む

# --- ポータル（本家 spec-workflow-mcp の見張り）---------------------------
# 本家 spec-workflow-mcp のダッシュボードの URL。別途起動しておく
NUXT_UPSTREAM_BASE_URL=http://127.0.0.1:5000

# `.spec-workflow` を持つディレクトリを探す親パス。直下1階層だけを走査する
NUXT_PROJECTS_PARENT_PATH=/opt/projects

# 本家のグローバル状態の置き場。activeProjects.json がここにある。
# 本家の SPEC_WORKFLOW_HOME と同じ値を指すこと。未設定なら ~/.spec-workflow-mcp に落ちる
NUXT_SPEC_WORKFLOW_HOME=/opt/projects/.spec-workflow-mcp

# --- ストローク（置き場）--------------------------------------------------
# 置き場2件だけが `.env` で差し替えられる。動かす機械ごとに変わるためで、
# 他の設定は機械が変わっても変わらないので nuxt.config.ts に書かれた値だけを使う。
# 何も設定しなければ既定値で動く。既定値はコメントの `=` の右に書いてある。

# セッションディレクトリの置き場。絶対パスであること。
# この配下の作成と所有権付与はアプリの外で行う（docs/adr）
#NUXT_SESSIONS_ROOT=/var/lib/stroke-board/sessions
# 承認時にプロジェクトのトップディレクトリを作る場所。絶対パスであること
#NUXT_PROJECTS_ROOT=/opt/projects

{
  "mcpServers": {
    "specworkflow": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@pimzino/spec-workflow-mcp@latest",
        "/opt/projects/stroke-board"
      ],
      "env": {
        "SPEC_WORKFLOW_HOME": "/opt/projects/.spec-workflow-mcp",
        "SPEC_WORKFLOW_SHARED_ROOT": "/opt/projects/stroke-board"
      }
    }
  }
}
